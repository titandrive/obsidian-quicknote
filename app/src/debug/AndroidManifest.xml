<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Debug builds only: adb shell am broadcast -n local.obsidianwidget/.ThemeProbe -->
        <receiver android:name=".ThemeProbe" android:exported="true" />
        <!-- Debug builds only, so the editor can be opened and checked from adb. -->
        <activity android:name=".EditorActivity" android:exported="true" tools:replace="android:exported" />
        <activity android:name=".TapActivity" android:exported="true" tools:replace="android:exported" />
    </application>
</manifest>

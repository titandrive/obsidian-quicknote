<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:tint="#FF1E1E1E"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:paddingTop="7dp"
        android:paddingBottom="11dp">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!--
                Drawn as an image so it can use the vault's font. Sized to the image rather than
                squeezed into the row, so it isn't shrunk at large system font sizes.
            -->
            <ImageView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="gone"
                android:minHeight="38dp"
                android:scaleType="fitStart"
                android:paddingVertical="7dp" />

            <!--
                What shows until the app draws the real title: in the widget picker's preview, and if
                the launcher ever shows the widget before the app has redrawn it (after an update).
            -->
            <TextView
                android:id="@+id/title_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:paddingVertical="9dp"
                android:text="@string/widget_title_placeholder"
                android:textColor="#FFDADADA"
                android:textSize="16.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_read"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="9dp"
                android:src="@drawable/ic_read"
                android:contentDescription="@string/reading_mode" />

            <ImageView
                android:id="@+id/btn_refresh"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="9dp"
                android:src="@drawable/ic_refresh"
                android:contentDescription="@string/refresh" />

            <!-- Takes the refresh button's place while refreshing; a widget can't animate an image itself. -->
            <ProgressBar
                android:id="@+id/refresh_spin"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="9dp"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/refresh_spin"
                android:indeterminateDuration="900"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btn_open"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="9dp"
                android:src="@drawable/ic_open"
                android:contentDescription="@string/open_in_obsidian" />

            <ImageView
                android:id="@+id/btn_settings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="9dp"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings" />

            <ImageView
                android:id="@+id/btn_edit"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="9dp"
                android:src="@drawable/ic_edit"
                android:contentDescription="@string/edit" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingEnd="8dp">

            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:listSelector="@android:color/transparent"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="top|start"
                android:text="@string/empty_note"
                android:textColor="#FF999999"
                android:textSize="14sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
